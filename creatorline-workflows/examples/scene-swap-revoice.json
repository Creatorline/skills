{
  "name": "Scene swap and re-voice",
  "description": "A real source clip (uploaded first) with the avatar swapped in by the scene-video step, then re-voiced with the avatar's cloned voice and captioned. No prompt needed on scene video; the source drives everything.",
  "brand_id": "<brand id from list_brands>",
  "nodes": [
    {
      "id": "swap",
      "kind": "generation",
      "title": "Swap the avatar in",
      "stageId": "scene-video",
      "modelId": "character-swap-transfer",
      "slotBindings": { "source_video": "<asset id of the uploaded source clip>" },
      "params": { "resolution": "720p" }
    },
    {
      "id": "voice",
      "kind": "generation",
      "title": "Avatar voice",
      "stageId": "change-voice",
      "params": { "remove_background_noise": true }
    },
    {
      "id": "captions",
      "kind": "generation",
      "title": "Hook and captions",
      "stageId": "caption-burn",
      "params": { "hook_mode": "auto", "caption_style": "hormozi" }
    },
    {
      "id": "post",
      "kind": "publish",
      "prompt": "you were not ready for this one",
      "publishChannels": ["TikTok", "IG"],
      "postSettings": { "videoMadeWithAi": true }
    }
  ],
  "edges": [
    { "source": "swap", "target": "voice" },
    { "source": "voice", "target": "captions" },
    { "source": "captions", "target": "post" }
  ]
}
